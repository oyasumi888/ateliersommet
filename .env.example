# Copy this file to `.env.local` (git-ignored) and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
#
# These values are read at build time and are shown on the public page, so they keep
# your details out of the git repository, not hidden from visitors.
# Any value left empty is simply not rendered.

# Production URL without a trailing slash, e.g. https://ateliersommet.com
VITE_SITE_URL=

# Person or team visitors will be talking to, e.g. "Jane Doe, Founder"
VITE_CONTACT_NAME=
# Public contact email, e.g. hello@yourdomain.com
VITE_CONTACT_EMAIL=
# Phone number in any readable format, e.g. +1 (555) 010-0000
VITE_CONTACT_PHONE=
# City / country or full address, e.g. "Montreal, Canada · Working worldwide"
VITE_CONTACT_ADDRESS=
# Optional scheduling link (Calendly, Cal.com, Google Calendar...)
VITE_CONTACT_BOOKING_URL=
